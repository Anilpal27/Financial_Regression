     "name": "stdout",
     "output_type": "stream",
     "text": [
      "(3123, 45)\n",
      "(781, 45)\n",
      "(3123,)\n",
      "(781,)\n"
     ]
    }
   ],
   "source": [
    "print(X_train.shape)\n",
    "print(X_test.shape)\n",
    "print(y_train.shape)\n",
    "print(y_test.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "269c7049-6675-48ca-a77d-148f3c51c0b7",
   "metadata": {},
   "source": [
    "### Linear regression model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "id": "608ed5a4-83bb-4843-8426-251de7c834c0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Linear Regression:\n",
      "Training R2 Score: 0.9999088515927462\n",
      "Training RMSE: 0.2829348402598579\n",
      "Testing R2 Score: 0.9999203422279666\n",
      "Testing RMSE: 0.2616711103546731\n"
     ]
    }
   ],
   "source": [
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import r2_score\n",
    "from sklearn.metrics import mean_squared_error\n",
    "\n",
    "lin = LinearRegression()                          # Create a Linear Regression model\n",
    "model_dt = lin.fit(X_train, y_train)              # Train (fit) the model using the training data\n",
    "\n",
    "ytrain_pred = model_dt.predict(X_train)           # Predict the target values for the training dataset\n",
    "y_pred = model_dt.predict(X_test)                 # Predict the target values for the testing dataset\n",
    "\n",
    "# Evaluate the model using R² Score and RMSE\n",
    "print(\"Linear Regression:\")\n",
    "print(\"Training R2 Score:\", r2_score(y_train, ytrain_pred))\n",
    "print(\"Training RMSE:\", np.sqrt(mean_squared_error(y_train, ytrain_pred)))\n",
    "print(\"Testing R2 Score:\", r2_score(y_test, y_pred))\n",
    "print(\"Testing RMSE:\", np.sqrt(mean_squared_error(y_test, y_pred)))"
   ]
  },
