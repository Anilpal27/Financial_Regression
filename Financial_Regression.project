   "id": "8a37338a-5f44-4d6c-b557-f582f9c3da56",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x1200 with 46 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "t=1\n",
    "plt.figure(figsize=(15,12))\n",
    "for i in num_cols:\n",
    "    plt.subplot(7,7,t)\n",
    "    sns.histplot(df[i])\n",
    "    plt.title(f'{i} skewness:{round(df[i].skew(),2)}')\n",
    "    t+=1\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "c5779ec1-995b-474e-9825-5a5bdbf04699",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 2800x2800 with 46 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# box plot for numericas figrures\n",
    "plt.figure(figsize=(28,28))\n",
    "for t, col in enumerate (num_cols,1):\n",
    "    plt.subplot(7,7,t)\n",
    "    sns.boxplot(y=df[col])\n",
    "    plt.title(col)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
