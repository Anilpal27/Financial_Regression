     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x1200 with 46 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "t=1\n",
    "plt.figure(figsize=(15,12))\n",
    "for i in num_cols:\n",
    "    plt.subplot(7,7,t)\n",
    "    sns.distplot(df[i])\n",
    "    plt.title(f'{i} skewness:{round(df[i].skew(),2)}')\n",
    "    t+=1\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
