   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.figure(figsize=(8,6))\n",
    "\n",
    "plt.scatter(y_test, y_test_pred)\n",
    "\n",
    "plt.xlabel(\"Actual Gold Price\")\n",
    "plt.ylabel(\"Predicted Gold Price\")\n",
    "plt.title(\"Actual vs Predicted\")\n",
    "\n",
    "plt.show()"
   ]
  },
