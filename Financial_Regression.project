   "source": [
    "residuals = y_test - y_test_pred\n",
    "\n",
    "plt.figure(figsize=(8,6))\n",
    "\n",
    "sns.scatterplot(\n",
    "    x=y_test_pred,\n",
    "    y=residuals\n",
    ")\n",
    "\n",
    "plt.axhline(y=0, color='red', linestyle='--')\n",
    "\n",
    "plt.xlabel(\"Predicted Gold Price\")\n",
    "plt.ylabel(\"Residuals\")\n",
    "plt.title(\"Residual Plot\")\n",
    "\n",
    "plt.show()"
   ]
